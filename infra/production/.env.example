# Production settings for docker-compose.yml. Copy to .env (never commit .env) and fill in.
# Generate each secret with:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# ── Addresses: point each domain's DNS A record at this server first ──
SITE_DOMAIN=example.org
ADMIN_DOMAIN=admin.example.org
PORTAL_DOMAIN=partners.example.org
# Let's Encrypt sends certificate expiry warnings here
ACME_EMAIL=you@example.org

# ── Secrets ──
POSTGRES_PASSWORD=
JWT_SECRET=
REVALIDATE_SECRET=

# ── Telegram (from @BotFather) ──
TELEGRAM_BOT_TOKEN=
# Bot username without @
TELEGRAM_BOT_USERNAME=

# ── Email over SMTP (any provider; see docs/DEPLOY.md) ──
# smtps://USER:PASSWORD@HOST:465  or  smtp://USER:PASSWORD@HOST:587  (URL-encode special characters in the password)
SMTP_URL=
# Sender address, on a domain you have verified with the provider (SPF + DKIM), and the name shown
MAIL_FROM=no-reply@example.org
MAIL_FROM_NAME=Проверено: Африка
# Where partners' replies go
MAIL_REPLY_TO=partners@example.org
# Staff inbox(es) for new DMC applications, fam-trip requests, quotes for operators without a login; comma-separated
STAFF_EMAILS=ops@example.org
