{
  "name": "tourists-trust-app",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:migrate": "pnpm --filter @ttp/api prisma:migrate",
    "db:seed": "pnpm --filter @ttp/api prisma:seed",
    "dev:api": "pnpm --filter @ttp/api dev",
    "dev:admin": "pnpm --filter @ttp/admin dev",
    "e2e": "pnpm --filter @ttp/admin e2e"
  }
}
