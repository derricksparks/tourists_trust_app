DATABASE_URL=postgresql://ttp:ttp@localhost:5432/ttp
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# Seeded admin login (dev only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
# Telegram bot token from @BotFather: validates Mini App sign-ins and sends staff replies
TELEGRAM_BOT_TOKEN=
# Public site's revalidation hook and its shared secret (same value as REVALIDATE_SECRET in apps/web-content)
WEB_REVALIDATE_URL=http://localhost:3001/api/revalidate
REVALIDATE_SECRET=change-me-revalidate
# Public site address, used in review-invite links
SITE_URL=http://localhost:3001
# Partner portal and admin dashboard addresses, used in email links
PORTAL_URL=http://localhost:5174
ADMIN_URL=http://localhost:5173
# Email over SMTP. Leave SMTP_URL empty in development: emails are then only logged.
SMTP_URL=
MAIL_FROM=no-reply@example.org
MAIL_FROM_NAME=Проверено: Африка
MAIL_REPLY_TO=
# Staff inbox(es) for new DMC applications and fam-trip requests, comma-separated
STAFF_EMAILS=
# Operators' uploaded documents: folder and encryption key (openssl rand -base64 32).
# Without the key, development derives one from JWT_SECRET.
UPLOAD_DIR=uploads
DOCUMENT_ENCRYPTION_KEY=
