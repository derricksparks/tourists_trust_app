# Core API (server-side fetches and the /backend proxy)
API_URL=http://localhost:3000
# Public address of this site, used in canonical links, the sitemap and the badge embed code
SITE_URL=http://localhost:3001
# Shared with the API (REVALIDATE_SECRET there) so it can refresh cached pages
REVALIDATE_SECRET=change-me-revalidate
# Telegram bot username without @, for "request info" links (t.me/<bot>?startapp=...)
TELEGRAM_BOT_USERNAME=TrustAfricaDemoBot
