{
  "name": "@ttp/telegram-bot",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@ttp/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "2.1.8"
  }
}
