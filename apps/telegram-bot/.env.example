# From @BotFather. Must be the same token the API uses (TELEGRAM_BOT_TOKEN there).
TELEGRAM_BOT_TOKEN=
# Core API (public endpoints)
API_URL=http://localhost:3000
# Public site; the Mini App lives at SITE_URL/tg and must be HTTPS for Telegram to open it
SITE_URL=http://localhost:3001
# Optional: a stand-in for api.telegram.org in tests
TELEGRAM_API_BASE=https://api.telegram.org
